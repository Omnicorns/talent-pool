# Salin menjadi .env lalu isi dengan nilai acak. Jangan commit file .env.
POSTGRES_PASSWORD=
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/talent_pool
SPRING_DATASOURCE_USERNAME=talent_pool
SPRING_DATASOURCE_PASSWORD=
ADMIN_USERNAME=
ADMIN_PASSWORD=
RECRUITER_USERNAME=
RECRUITER_PASSWORD=
# Opsional: akun pimpinan yang hanya melihat halaman ringkasan (password min. 12 karakter)
VIEWER_USERNAME=
VIEWER_PASSWORD=
# openssl rand -base64 48
TALENT_JWT_SECRET=
# Email lowongan baru ke anggota talent pool (butuh APP_MAIL_ENABLED=true)
JOB_ALERTS_ENABLED=true
JOB_ALERTS_DELAY_MS=200
